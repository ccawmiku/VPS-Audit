[Unit]
Description=VLESS Passive Traffic & Domain Auditor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vless-audit
Group=vless-audit
EnvironmentFile=-/etc/vless-audit.env
ExecStart=/usr/local/bin/vless-audit
Restart=on-failure
RestartSec=3

# Dedicated non-root service with only CAP_NET_RAW for AF_PACKET
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
StateDirectory=vless-audit
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
