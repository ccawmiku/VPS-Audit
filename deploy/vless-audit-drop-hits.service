[Unit]
Description=Read Spamhaus DROP hits for vless-audit
After=vless-audit-blocklist.service

[Service]
Type=oneshot
User=root
Group=vless-audit
ExecStart=/usr/bin/python3 -I /usr/local/libexec/vless-audit-blocklist --drop-hits
ReadWritePaths=/var/lib/vless-audit-blocklist
UMask=0077
TimeoutStartSec=15
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
